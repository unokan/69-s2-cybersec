# REST

## Variables
@admin_email: = {{$dotenv ADMIN_EMAIL}},
@admin_password: = {{$dotenv ADMIN_PASSWORD}},

@user_email: = {{$dotenv USER_EMAIL}},
@user_password: = {{$dotenv USER_PASSWORD}},

## 1. Admin
### 1.1 Login (Admin)
POST http://localhost:9092/admin/login
Content-Type: application/json

{
    "email": "{{admin_email}}",
    "password": "{{admin_password}}",
    "rememberMe": false
}

### 1.2 Register (Admin) one time for first time to create admin account
POST http://localhost:9092/admin/register-admin
Content-Type: application/json

{
    "firstname": "{{admin_firstname}}",
    "lastname": "{{admin_lastname}}",
    "email": "{{admin_email}}",
    "password": "{{admin_password}}"
}

### 1.3 Forgot Password
POST http://localhost:9092/admin/forgot-password
Content-Type: application/json

{
    "email": "{{admin_email}}"
}

### 1.3.1 Reset Password (Admin)
POST http://localhost:9092/admin/reset-password
Content-Type: application/json

{
    "resetPasswordToken": "{{admin_reset_code}}",
    "password": "{{admin_new_password}}"
}

### 1.4 Profile
GET http://localhost:9092/admin/users/me
Authorization: Bearer {{admin_jwt_token}}

## 2. User
### 2.1 Login
POST http://localhost:9092/api/auth/local
Content-Type: application/json

{
    "identifier": "{{user_email}}",
    "password": "{{user_password}}"
}

### 2.2 Register
POST http://localhost:9092/api/auth/local/register
Content-Type: application/json

{
    "username": "{{user_username}}",
    "email": "{{user_email}}",
    "password": "{{user_password}}"
}

### 2.3 Forgot Password
POST http://localhost:9092/api/auth/forgot-password
Content-Type: application/json

{
    "email": "{{user_email}}"
}

### 2.3.1 Reset Password
POST http://localhost:9092/api/auth/reset-password
Content-Type: application/json

{
    "code": "{{user_reset_code}}",
    "password": "{{user_new_password}}",
    "passwordConfirmation": "{{user_new_password}}"
}

### 2.4 Profile
GET http://localhost:9092/api/users/me
Authorization: Bearer {{user_jwt_token}}

